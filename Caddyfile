# Self-hosted: Caddy terminates TLS for everything. ClickHouse is internal
# only (no public proxy) — the web app reaches it over the compose network.

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	encode gzip
	reverse_proxy web:3000
}

{$TRACKER_DOMAIN} {
	reverse_proxy tracker:3001
}
