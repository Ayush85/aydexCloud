# Environment files — never commit secrets
.env
.env.local
.env.*.local

# Claude Code local settings — personal, and has held real credentials before
.claude/settings.local.json

# Node / Next.js
web/node_modules/
web/.next/
web/.turbo/
web/out/
web/dist/
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*
web/.pnpm-debug.log*

# Prisma generated client (regenerated at build time)
web/node_modules/.prisma/

# Go build artifacts
tracker/tracker
tracker/*.exe

# Docker volumes / local data (if ever mounted locally)
data/
volumes/

# GeoIP database — fetched via scripts/update-geoip.sh, not committed
db/geoip/*.mmdb

# Sentry source map upload artifacts
web/.sentryclirc

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Test coverage
coverage/
*.lcov

# TypeScript incremental build cache
web/tsconfig.tsbuildinfo
