web/node_modules/.prisma/

# Go build artifacts
tracker/tracker
tracker/*.exe

# Docker volumes / local data (if ever mounted locally)
data/
volumes/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Test coverage
coverage/
*.lcov
