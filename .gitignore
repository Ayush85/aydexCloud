# Environment files — never commit secrets
.env
.env.local
.env.*.local

# Node / Next.js
web/node_modules/
web/.next/
web/.turbo/
web/out/
web/dist/
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*
