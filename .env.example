# ── Domains ──────────────────────────────────────────────────────────────────
# Bare hostnames (no scheme) Caddy terminates TLS for and reverse-proxies.
# APP_DOMAIN also gets a `www.` alias. Must match the hosts baked into
# NEXTAUTH_URL / NEXT_PUBLIC_TRACKER_URL below.
APP_DOMAIN=your-domain.com
TRACKER_DOMAIN=t.your-domain.com

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Only used by the `postgres` container itself — irrelevant if DATABASE_URL
# below points at a managed provider (Neon, Supabase, RDS, ...) instead.
POSTGRES_DB=aydex
POSTGRES_USER=aydex
POSTGRES_PASSWORD=change-me

# ── Next.js / Web ────────────────────────────────────────────────────────────
# Self-hosted (docker-compose): must match POSTGRES_PASSWORD above and use the
# `postgres` service hostname, e.g. postgresql://aydex:change-me@postgres:5432/aydex
#
# Vercel / serverless: point this at your provider's *pooled* connection
# string (Neon: the default one; Supabase: the "Transaction" pooler on port
# 6543) — serverless functions open far more concurrent connections than a
# single long-lived server does, and a bare Postgres connection limit runs
# out fast without pooling.
DATABASE_URL=postgresql://aydex:change-me@postgres:5432/aydex

# Only used by the Prisma CLI (db push/migrate), which needs a direct,
# unpooled session. Self-hosted: same value as DATABASE_URL. Neon/Supabase:
# the direct/session connection string (Neon: "-pooler" removed from the
# host; Supabase: port 5432 instead of 6543).
DIRECT_URL=postgresql://aydex:change-me@postgres:5432/aydex

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Public-facing URL of the web app
NEXTAUTH_URL=https://your-domain.com

# Public-facing URL where script.js is served (your tracker) — a dedicated
# subdomain, not a path, so the reverse proxy needs no path-rewrite rules
NEXT_PUBLIC_TRACKER_URL=https://t.your-domain.com

# ── ClickHouse ───────────────────────────────────────────────────────────────
# Self-hosted (docker-compose): leave as-is, talks to the `clickhouse` service.
# ClickHouse Cloud: CLICKHOUSE_HOST is the HTTPS endpoint (port 8443) used by
# the web app; CLICKHOUSE_ADDR is the native-protocol host:port (port 9440,
# with CLICKHOUSE_TLS=true) used by the Go tracker — both point at the same
# instance, just different protocols/ports.
CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TLS=false

# ── Redis ────────────────────────────────────────────────────────────────────
# Self-hosted (docker-compose): leave as-is, talks to the `redis` service.
# Upstash / managed: use the rediss:// TLS connection string from your
# provider's dashboard — the password and TLS config are carried in the URL.
REDIS_URL=redis://redis:6379

# ── Host ports ───────────────────────────────────────────────────────────────
# Bound to 127.0.0.1 in docker-compose.yml — only reachable from this host,
# so Caddy (ports 80/443) is the only public entry point in production
WEB_PORT=3000
TRACKER_PORT=3001

# ── Stripe billing ───────────────────────────────────────────────────────────
# Create a Starter/Pro/Agency product+price in your Stripe dashboard (test mode
# is fine to start) and paste the price ids below. Until these are set,
# checkout returns a clear "not configured yet" error instead of failing.
STRIPE_SECRET_KEY=
# Configure a webhook endpoint at /api/billing/webhook and paste its signing secret
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ── Email digests (Resend) ───────────────────────────────────────────────────
# https://resend.com — weekly digest emails no-op silently until this is set
RESEND_API_KEY=
# Must be on a domain verified in your Resend account, or sends will fail
EMAIL_FROM=aydex.cloud <digest@your-domain.com>
# Shared secret the `cron` service sends to /api/cron/weekly-digest
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Both web and tracker no-op until set
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── GeoIP (country data) ─────────────────────────────────────────────────────
# Free account at https://www.maxmind.com/en/geolite2/signup, then run:
#   MAXMIND_LICENSE_KEY=xxxx ./scripts/update-geoip.sh
# Country data is empty until db/geoip/GeoLite2-Country.mmdb exists — the
# tracker fails open (no country, no errors) without it. Not a container env
# var itself; only used by the update script.
