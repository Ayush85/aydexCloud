# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=aydex
POSTGRES_USER=aydex
POSTGRES_PASSWORD=change-me

# ── Next.js / Web ────────────────────────────────────────────────────────────
# Must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://aydex:change-me@postgres:5432/aydex

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Public-facing URL of the web app
NEXTAUTH_URL=https://your-domain.com

# Public-facing URL where script.js is served (your tracker)
NEXT_PUBLIC_TRACKER_URL=https://your-domain.com/tracker

# ── Host ports ───────────────────────────────────────────────────────────────
WEB_PORT=3000
TRACKER_PORT=3001
